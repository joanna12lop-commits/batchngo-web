# Public Supabase project settings. Safe to expose to the browser; RLS remains mandatory.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_ and never import from Client Components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public application origin used for Auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
